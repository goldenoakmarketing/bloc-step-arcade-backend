{
  "name": "bloc-step-arcade-backend",
  "version": "1.0.0",
  "description": "Backend infrastructure for Bloc Step Arcade - game server, Farcaster bot, and analytics",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:run": "npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "keywords": [
    "blockchain",
    "gaming",
    "farcaster",
    "base"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@napi-rs/canvas": "^0.1.65",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "viem": "^2.7.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.10",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
